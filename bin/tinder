#!/usr/bin/env python3
# This file is placed in the Public Domain.


"objects"


import inspect
import os
import shutil
import sys
import threading
import time


sys.path.insert(0, os.getcwd())


from objz.clients import Client
from objz.command import Config, Mods, command, parse, scanner
from objz.handler import Event
from objz.threads import launch, name
from objz.persist import Workdir
from objz.utility import elapsed, parse



path = inspect.getfile(Config)
Mods.dirs["objx.modules"] = os.path.join(os.path.dirname(path), "modules")
Workdir.wdr = ".test"


events = []
examples = {
    "cmd": [""],
    "dne": ["", "test2"],
    "log": ["", "test"],
    "fnd": ["", "log", "todo"],
    "tdo": ["", "test2", "test3"]
}



class CLI(Client):

    def __init__(self):
        Client.__init__(self)
        self.register("command", command)

    def raw(self, txt):
        if "v" in Config.opts:
            print(txt)


def payload(clt):
    for cmd, example in examples.items():
        for ex in example:
            evt = Event()
            evt.orig = repr(clt)
            evt.txt = f"{cmd} {ex}"
            evt.type = "command"
            clt.put(evt)
            events.append(evt)


def main():
    parse(Config, " ".join(sys.argv[1:]))
    nr = Config.index or 100
    if os.path.exists(Workdir.wdr):
        shutil.rmtree(Workdir.wdr)
    clt = CLI()
    clt.start()
    scanner()
    starttime = time.time()
    thrs = []
    for _x in range(nr):
        thrs.append(launch(payload, clt))
    for thr in thrs:
        thr.join()
    gotcha = []
    for evt in events:
        evt.wait()
        gotcha.append(evt)
    nrevents = len(events)
    for evt in gotcha:
        events.remove(evt)
    endtime = time.time()
    lap = elapsed(endtime-starttime)
    percall = (endtime-starttime)/nrevents
    if "v" in Config.opts:
        print(f"{len(events)} events left.")
        print(f"total: {lap} nrs: {nr} call: %.6fs" % percall)
    sys.exit()


if __name__ == "__main__":
    main()
